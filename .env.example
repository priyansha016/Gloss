# Database (asyncpg URL for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://youtube_skim:youtube_skim@localhost:5432/youtube_skim

# Redis (arq queue + rate limiter)
REDIS_URL=redis://localhost:6379

# ── LLM ───────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Copy ONE profile below into .env and fill keys.

# Recommended (free): Groq primary + Gemini automatic failover.
# When Groq hits its rate/day cap (429), chat calls retry on the fallback provider.
OPENAI_API_KEY=gsk_...
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

FALLBACK_OPENAI_API_KEY=
FALLBACK_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Comma-separated, tried in order (hot model first, stable lite model as backstop):
FALLBACK_OPENAI_MODEL=gemini-3.5-flash,gemini-flash-lite-latest

# Alt — OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Alt — local Ollama on your Mac (run: ollama serve). Free, private, slower.
# Use host.docker.internal when api/worker run inside Docker; localhost if not.
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=qwen2.5:14b      # produces valid diagrams + worked examples (~9GB)
# OPENAI_MODEL=gemma3:4b        # lighter/faster, weaker structured output

# NOTE: after editing this file, `docker compose restart` is NOT enough — containers
# keep their creation-time env. Run: docker compose up -d --force-recreate worker api

# Embeddings for shared glossary dedupe (Ollama: nomic-embed-text = 768 dims).
# Only used when FAST_PROCESSING=false. Keep EMBEDDING_DIMENSIONS in sync with the model.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# ── Pipeline knobs ─────────────────────────────────────────────────────────────
# FAST_PROCESSING: cheap knobs only — smaller glossary + skip transcript cleanup.
# It does NOT control the verifier/visuals (see below).
FAST_PROCESSING=true
LLM_CONCURRENCY=2
MAX_GLOSSARY_TERMS=15

# Expensive quality stages. Turn off to cut LLM calls (dev, or a tight quota).
ENABLE_VERIFIER=true
ENABLE_VISUALS=true

# ── Rate limiting (per-IP, 1-hour fixed window) ────────────────────────────────
# Protects the free LLM quota on a public deploy. Set false for local dev.
# Public demo window (your key): keep submit low — each video is many LLM calls.
# Local / BYOK: 15/40/20 is fine; visitors with their own key aren't on your quota.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SUBMIT_PER_HOUR=3
RATE_LIMIT_ASK_PER_HOUR=30
RATE_LIMIT_PRACTICE_PER_HOUR=15

# ── Bring your own key ─────────────────────────────────────────────────────────
# false: visitors use the server's OPENAI_API_KEY above (fine locally; on a public
#        deploy it spends YOUR quota).
# true:  every request that spends tokens must carry the visitor's own key
#        (X-LLM-Key header, set by the UI). Cached documents stay readable without
#        a key, and the FALLBACK_* provider is never used for someone else's key.
REQUIRE_USER_KEY=false

# ── Owner dashboard & homepage showcase ────────────────────────────────────────
# GET /api/admin/stats with header X-Admin-Key. Empty = endpoint hidden (404).
# Frontend: https://your-site.workers.dev/admin (not linked publicly).
ADMIN_SECRET=

# Optional: comma-separated video UUIDs for "See it in action" on the homepage.
# Empty = auto-list the 6 most recently finished ready docs.
# SHOWCASE_VIDEO_IDS=uuid1,uuid2

# ── YouTube fetch ──────────────────────────────────────────────────────────────
# Leave empty for local dev (residential IP works). In production YouTube often
# blocks datacenter IPs; set a residential/rotating proxy for captions + watch page.
# Example: YOUTUBE_PROXY_URL=http://user:pass@proxy.example.com:8080
YOUTUBE_PROXY_URL=

# ── Web ────────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (your frontend URL in production).
CORS_ORIGINS=http://localhost:3000

# Frontend → backend URL (browser uses NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:8000
